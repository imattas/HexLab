if(NOT EXISTS "${ORACLE}" OR NOT EXISTS "${CHECKER}")
  message(FATAL_ERROR "Native Win32 execution oracle and x64 checker are both required")
endif()
execute_process(COMMAND "${ORACLE}" RESULT_VARIABLE native_status OUTPUT_VARIABLE measurements ERROR_VARIABLE native_error TIMEOUT 10)
if(NOT "${native_status}" STREQUAL "0")
  message(FATAL_ERROR "Authored Win32 execution failed: ${native_status}: ${native_error}")
endif()
get_filename_component(directory "${MEASUREMENTS}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
file(WRITE "${MEASUREMENTS}" "${measurements}")
execute_process(COMMAND "${CHECKER}" "${MEASUREMENTS}" RESULT_VARIABLE checked OUTPUT_VARIABLE proof ERROR_VARIABLE failure TIMEOUT 10)
if(NOT "${checked}" STREQUAL "0")
  message(FATAL_ERROR "Original decoder disagrees with independent Win32 execution:\n${proof}\n${failure}")
endif()
message(STATUS "Independent Win32 execution: ${proof}")
