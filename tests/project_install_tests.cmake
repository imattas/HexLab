if(NOT IS_ABSOLUTE "${PREFIX}" OR NOT IS_DIRECTORY "${PREFIX}/bin" OR NOT IS_DIRECTORY "${TEST_BIN}")
  message(FATAL_ERROR "Supply absolute installed PREFIX and built TEST_BIN")
endif()
# Copies only validation executables. Their directory contains no runtime DLLs;
# the child PATH resolves the installed engines and toolkit.
set(validation "${PREFIX}/validation")
file(MAKE_DIRECTORY "${validation}/tools")
set(ENV{PATH} "${PREFIX}/bin;$ENV{PATH}")
foreach(tool IN ITEMS hexlab_fixture_generator hexlab_project_cli_oracle
    hexlab_project_crash_helper hexlab_project_save_crash_helper)
  file(COPY "${TEST_BIN}/${tool}.exe" DESTINATION "${validation}/tools")
endforeach()
get_filename_component(config "${TEST_BIN}" NAME)
get_filename_component(build_root "${TEST_BIN}/../.." ABSOLUTE)
if(NOT NATIVE_ORACLE)
  set(NATIVE_ORACLE "${build_root}/tests/x86-32-oracle/${config}/hexlab_x86_32_oracle.exe")
endif()
if(NOT EXISTS "${NATIVE_ORACLE}")
  message(FATAL_ERROR "Installed validation requires the independently built Win32 oracle")
endif()
file(COPY "${TEST_BIN}/hexlab_processor_x86_cpu_tests.exe" DESTINATION "${validation}/tools")
file(MAKE_DIRECTORY "${validation}/native-x86")
file(COPY "${NATIVE_ORACLE}" DESTINATION "${validation}/native-x86")
set(ORACLE "${validation}/native-x86/hexlab_x86_32_oracle.exe")
set(CHECKER "${validation}/tools/hexlab_processor_x86_cpu_tests.exe")
set(MEASUREMENTS "${validation}/native-x86/measurements.txt")
include("${CMAKE_CURRENT_LIST_DIR}/x86_cpu_oracle.cmake")
set(CLI "${PREFIX}/bin/hexlab_cli.exe")
set(GENERATOR "${validation}/tools/hexlab_fixture_generator.exe")
set(ORACLE "${validation}/tools/hexlab_project_cli_oracle.exe")
set(FIXTURES "${validation}/project-cli")
include("${CMAKE_CURRENT_LIST_DIR}/project_cli_tests.cmake")
find_program(POWERSHELL powershell REQUIRED)
foreach(kind IN ITEMS crash save_crash)
  set(HELPER "${validation}/tools/hexlab_project_${kind}_helper.exe")
  set(FIXTURES "${validation}/${kind}")
  include("${CMAKE_CURRENT_LIST_DIR}/project_${kind}_tests.cmake")
endforeach()
if(DESKTOP)
  foreach(kind IN ITEMS mode segment edit search graph reference orphan close project binary)
    set(executable "${validation}/tools/hexlab_desktop_${kind}_tests.exe")
    file(COPY "${TEST_BIN}/hexlab_desktop_${kind}_tests.exe" DESTINATION "${validation}/tools")
    execute_process(COMMAND "${executable}" WORKING_DIRECTORY "${validation}"
      RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 50)
    if(NOT "${status}" STREQUAL "0")
      message(FATAL_ERROR "Installed desktop ${kind}: ${status}; ${output}; ${error}")
    endif()
  endforeach()
  foreach(mode IN ITEMS x86-64 x86-32 x86-16)
    execute_process(COMMAND "${POWERSHELL}" -NoProfile -File "${CMAKE_CURRENT_LIST_DIR}/installed_runtime.ps1"
      -Prefix "${PREFIX}" -Mode "${mode}" RESULT_VARIABLE runtime_status OUTPUT_VARIABLE runtime_output ERROR_VARIABLE runtime_error TIMEOUT 30)
    if(NOT "${runtime_status}" STREQUAL "0")
      message(FATAL_ERROR "Installed application runtime audit ${mode}: ${runtime_status}; ${runtime_output}; ${runtime_error}")
    endif()
    message(STATUS "${runtime_output}")
  endforeach()
endif()
message(STATUS "Installed project CLI, recovery and desktop components verified: ${PREFIX}")
