execute_process(COMMAND "${CLI}" firmware inspect "${INPUT}" --format ihex
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "firmware CLI failed (${result}): ${error}")
endif()
foreach(expected IN ITEMS "Format: Intel HEX" "Data bytes: 6" "Records: 2" "Start address: 0x10"
                          "0x10 Size=0x4 SourceLine=1 Record=1 Backing=0x0"
                          "0x1000 Size=0x2 SourceLine=2 Record=2 Backing=0x4")
  string(FIND "${output}" "${expected}" found)
  if(found LESS 0)
    message(FATAL_ERROR "firmware CLI output lacks '${expected}': ${output}")
  endif()
endforeach()

function(firmware_project_check expected_status expected_output)
  execute_process(COMMAND "${CLI}" project ${ARGN}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
  if(NOT "${status}" STREQUAL "${expected_status}" OR NOT output MATCHES "${expected_output}")
    message(FATAL_ERROR "Firmware project '${ARGN}' returned ${status}: ${output}\n${error}")
  endif()
endfunction()
set(fixtures "${CMAKE_CURRENT_BINARY_DIR}/firmware-project-cli-fixtures")
file(MAKE_DIRECTORY "${fixtures}")
foreach(format IN ITEMS ihex srec)
  set(input "${fixtures}/source.${format}")
  set(project "${fixtures}/${format}.hxproj")
  set(exported "${fixtures}/exported.${format}")
  file(REMOVE "${project}" "${project}-wal" "${project}-shm" "${exported}")
  if(format STREQUAL "ihex")
    file(WRITE "${input}" ":01001000AA45\n:0400000500000010E7\n:00000001FF\n")
    set(description "Intel HEX")
  else()
    file(WRITE "${input}" "S1040010AA41\nS9030010EC\n")
    set(description "Motorola S-record")
  endif()
  firmware_project_check(0 "Saved:" create "${project}" --input "${input}" --format "${format}")
  file(REMOVE "${input}")
  firmware_project_check(0 "Format: ${description}.*Records: 1" inspect "${project}")
  firmware_project_check(0 "Edit revision: 1" rename "${project}" --at va:0x10 --name firmware_entry)
  firmware_project_check(0 "firmware_entry" inspect "${project}")
  firmware_project_check(0 "Edit revision: 2" patch "${project}" --at va:0x10 --bytes cc)
  firmware_project_check(0 "Exported:" export "${project}" --output "${exported}")
  file(READ "${exported}" exported_text)
  if(format STREQUAL "ihex")
    set(expected_export ":01001000CC23\n:0400000500000010E7\n:00000001FF\n")
  else()
    set(expected_export "S1040010CC1F\nS9030010EC\n")
  endif()
  if(NOT exported_text STREQUAL expected_export)
    message(FATAL_ERROR "Firmware patch export changed unrelated source text for ${format}: ${exported_text}")
  endif()
endforeach()
