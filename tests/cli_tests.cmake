if(NOT EXISTS "${CLI}")
  message(FATAL_ERROR "CLI executable does not exist: ${CLI}")
endif()
function(check_cli expected_status expected_out expected_err)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
  if(NOT "${status}" STREQUAL "${expected_status}")
    message(FATAL_ERROR "Arguments '${ARGN}': status ${status}; expected ${expected_status}; stderr=${error}")
  endif()
  if(NOT output MATCHES "${expected_out}" OR NOT error MATCHES "${expected_err}")
    message(FATAL_ERROR "Arguments '${ARGN}': unexpected stdout='${output}', stderr='${error}'")
  endif()
endfunction()
check_cli(0 "Usage: hexlab_cli" "^$")
check_cli(0 "Usage: hexlab_cli" "^$" --help)
check_cli(0 "^HexLab 0\\.1\\.1[\r\n]+$" "^$" --version)
check_cli(2 "^$" "Invalid arguments" --unknown)
check_cli(2 "^$" "Invalid arguments" --version extra)
check_cli(2 "^$" "Invalid arguments" --help extra)
