set(runner "${CMAKE_CURRENT_LIST_DIR}/x86_segment_oracle.cmake")
set(common "-DQEMU=${QEMU}" "-DNASM=${NASM}" "-DBOCHS=${BOCHS}" "-DASSEMBLY=${ASSEMBLY}"
  "-DARTIFACTS=${ARTIFACTS}" "-DCHECKER=${CHECKER}")
foreach(tool QEMU NASM BOCHS)
  execute_process(COMMAND "${CMAKE_COMMAND}" ${common} "-D${tool}=${ARTIFACTS}/absent-${tool}.exe" -P "${runner}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
  if(status EQUAL 0 OR NOT error MATCHES "${tool} is missing")
    message(FATAL_ERROR "Oracle did not reject missing ${tool}: ${status} ${output} ${error}")
  endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" ${common} "-DQEMU=${CHECKER}" -P "${runner}"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
if(status EQUAL 0 OR NOT error MATCHES "hash mismatch")
  message(FATAL_ERROR "Oracle accepted a foreign executable as the pinned CPU tool")
endif()
set(measured "${ARTIFACTS}/measurements.txt")
execute_process(COMMAND "${CHECKER}" "${measured}" RESULT_VARIABLE status TIMEOUT 3)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Negative contract requires genuine independently verified execution records")
endif()
file(READ "${measured}" genuine)
function(reject_record name contents reason)
  set(path "${ARTIFACTS}/negative-${name}.txt")
  file(WRITE "${path}" "${contents}")
  execute_process(COMMAND "${CHECKER}" "${path}" RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 3)
  if(status EQUAL 0 OR NOT "${output}${error}" MATCHES "${reason}")
    message(FATAL_ERROR "Oracle did not reject ${name} for ${reason}: ${status} ${output} ${error}")
  endif()
endfunction()
string(REPLACE "real_operand16=11221235" "real_operand16=00000000" forged "${genuine}")
reject_record(forged "${forged}" "real_operand16")
string(REPLACE "real_operand16=11221235\n" "" missing "${genuine}")
reject_record(missing "${missing}" "exact record count")
string(REPLACE "DONE\n" "real_operand16=11221235\nDONE\n" repeated "${genuine}")
reject_record(repeated "${repeated}" "repeated")
reject_record(trailing "${genuine}real_operand16=11221235\n" "trailing")
string(REPLACE "HX16_ORACLE_V1" "HX16_ORACLE_V9" bad_version "${genuine}")
reject_record(version "${bad_version}" "oracle version")
string(REPEAT "x" 65537 oversized)
reject_record(oversized "${oversized}" "exceeds")
execute_process(COMMAND "${CHECKER}" "${ARTIFACTS}/absent-measurements.txt" RESULT_VARIABLE status TIMEOUT 3)
if(status EQUAL 0)
  message(FATAL_ERROR "Oracle accepted missing measurement file")
endif()
message(STATUS "Pinned tools and missing/forged/repeated/trailing/version/oversized records rejected")
