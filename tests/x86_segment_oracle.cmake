foreach(required QEMU NASM BOCHS ASSEMBLY CHECKER)
  if(NOT EXISTS "${${required}}")
    message(FATAL_ERROR "Required authored16 oracle ${required} is missing: ${${required}}")
  endif()
endforeach()
function(require_hash path expected)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "Pinned16 oracle input missing: ${path}; run tests/provision_x86_16_tools.ps1")
  endif()
  file(SHA256 "${path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Pinned16 oracle input hash mismatch: ${path}")
  endif()
endfunction()
get_filename_component(qemu_dir "${QEMU}" DIRECTORY)
get_filename_component(bochs_dir "${BOCHS}" DIRECTORY)
require_hash("${QEMU}" dbbf7242e5b0d295e54336c69034a266ee1cc117d7ac6e3060e38bb61651200b)
require_hash("${qemu_dir}/share/bios-256k.bin" ae6f6aa973aaccc143f57aa960fb035fd9de4daee4ad0cd713322f8c259e7650)
require_hash("${NASM}" 04ec2385879f7e1c45dbe76c4020970555de48eeb97c23f59620ede061328f51)
require_hash("${BOCHS}" a59871b4cae1f8f7729eeb1419ec25e15543641b348bc32f712946d8fb04b1bb)
require_hash("${bochs_dir}/BIOS-bochs-latest" 530378cb25899f1063fb304d039edb33ea1c20ec784e65fed456233c07d9bf9a)
require_hash("${bochs_dir}/VGABIOS-lgpl-latest.bin" 157ee2e631c429114e48a8051c029ee79f1dc5adae59dd18178a6c6673c7cf37)
execute_process(COMMAND "${QEMU}" --version RESULT_VARIABLE version_status OUTPUT_VARIABLE version ERROR_VARIABLE version_error TIMEOUT 5)
if(NOT version_status EQUAL 0 OR NOT version MATCHES "11\\.1\\.0 \\(v11\\.1\\.0-12130-ge470268ff4\\)")
  message(FATAL_ERROR "Unexpected pinned QEMU: ${version} ${version_error}")
endif()
execute_process(COMMAND "${NASM}" -v RESULT_VARIABLE nasm_status OUTPUT_VARIABLE nasm_version TIMEOUT 5)
if(NOT nasm_status EQUAL 0 OR NOT nasm_version MATCHES "NASM version 3\\.02 ")
  message(FATAL_ERROR "Unexpected pinned NASM: ${nasm_version}")
endif()
file(MAKE_DIRECTORY "${ARTIFACTS}")
execute_process(COMMAND "${NASM}" -f bin -DQEMU_SAFE_ONLY=1 -o "${ARTIFACTS}/qemu-boot.img" -l "${ARTIFACTS}/qemu-boot.lst" "${ASSEMBLY}"
  RESULT_VARIABLE assembled OUTPUT_VARIABLE assembler_out ERROR_VARIABLE assembler_error TIMEOUT 5)
if(NOT assembled EQUAL 0)
  message(FATAL_ERROR "Authored16 assembly failed: ${assembler_out} ${assembler_error}")
endif()
execute_process(COMMAND "${QEMU}" -L "${qemu_dir}/share" -machine pc -accel tcg,thread=single -cpu pentium3 -m 16M
  -display none -monitor none -serial none -parallel none -nic none -no-reboot
  -drive "file=${ARTIFACTS}/qemu-boot.img,format=raw,if=floppy,readonly=on" -boot a
  -debugcon "file:${ARTIFACTS}/qemu-measurements.txt" -global isa-debugcon.iobase=0xe9
  -device isa-debug-exit,iobase=0xf4,iosize=0x04
  RESULT_VARIABLE executed OUTPUT_VARIABLE execution_out ERROR_VARIABLE execution_error TIMEOUT 8)
if(NOT executed STREQUAL "33")
  message(FATAL_ERROR "Authored16 QEMU did not complete: ${executed}\n${execution_out}\n${execution_error}")
endif()
execute_process(COMMAND "${CHECKER}" "${ARTIFACTS}/qemu-measurements.txt" qemu-safe
  RESULT_VARIABLE checked OUTPUT_VARIABLE check_out ERROR_VARIABLE check_error TIMEOUT 5)
if(NOT checked EQUAL 0)
  message(FATAL_ERROR "Authored16 measurements rejected:\n${check_out}\n${check_error}")
endif()
message(STATUS "${check_out}")
execute_process(COMMAND "${NASM}" -f bin -DBOCHS_HALT=1 -o "${ARTIFACTS}/boot.img" -l "${ARTIFACTS}/boot.lst" "${ASSEMBLY}"
  RESULT_VARIABLE assembled OUTPUT_VARIABLE assembler_out ERROR_VARIABLE assembler_error TIMEOUT 5)
if(NOT assembled EQUAL 0)
  message(FATAL_ERROR "Full authored16 assembly failed: ${assembler_out} ${assembler_error}")
endif()
file(WRITE "${ARTIFACTS}/bochsrc.txt" "config_interface: textconfig\ndisplay_library: nogui\nmegs: 16\ncpu: model=p3_katmai, ips=10000000\nromimage: file=\"${bochs_dir}/BIOS-bochs-latest\"\nvgaromimage: file=\"${bochs_dir}/VGABIOS-lgpl-latest.bin\"\nfloppya: 1_44=\"${ARTIFACTS}/boot.img\", status=inserted, write_protected=1\nboot: floppy\nlog: ${ARTIFACTS}/bochs-runtime.log\npanic: action=fatal\nerror: action=report\ninfo: action=ignore\ndebug: action=ignore\nport_e9_hack: enabled=1\ncom1: enabled=0\nparport1: enabled=0\nne2k: enabled=0\ne1000: enabled=0\nclock: sync=none, time0=0\n")
find_program(oracle_powershell powershell REQUIRED)
execute_process(COMMAND "${oracle_powershell}" -NoProfile -ExecutionPolicy Bypass
  -File "${CMAKE_CURRENT_LIST_DIR}/run_x86_bochs.ps1" -Bochs "${BOCHS}"
  -Config "${ARTIFACTS}/bochsrc.txt" -Output "${ARTIFACTS}/bochs-stdout.txt"
  RESULT_VARIABLE executed OUTPUT_VARIABLE bochs_out ERROR_VARIABLE bochs_error TIMEOUT 12)
if(NOT executed STREQUAL "0")
  message(FATAL_ERROR "Precise authored16 oracle did not reach its controlled halt: ${executed}\n${bochs_out}\n${bochs_error}")
endif()
file(READ "${ARTIFACTS}/bochs-stdout.txt" bochs_out)
string(FIND "${bochs_out}" "HX16_ORACLE_V1\n" records_begin)
if(records_begin LESS 0)
  message(FATAL_ERROR "Precise16 oracle did not emit its measurement header")
endif()
string(SUBSTRING "${bochs_out}" ${records_begin} -1 records)
file(WRITE "${ARTIFACTS}/measurements.txt" "${records}")
execute_process(COMMAND "${CHECKER}" "${ARTIFACTS}/measurements.txt"
  RESULT_VARIABLE checked OUTPUT_VARIABLE check_out ERROR_VARIABLE check_error TIMEOUT 5)
if(NOT checked EQUAL 0)
  message(FATAL_ERROR "Precise authored16 measurements rejected:\n${check_out}\n${check_error}")
endif()
message(STATUS "${check_out}")
