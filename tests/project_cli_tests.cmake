function(project_check status_expected out_expected err_expected)
  execute_process(COMMAND "${CLI}" project ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
  if(NOT "${status}" STREQUAL "${status_expected}" OR NOT output MATCHES "${out_expected}" OR NOT error MATCHES "${err_expected}")
    message(FATAL_ERROR "Project command '${ARGN}' expected ${status_expected}, got ${status}\nstdout=${output}\nstderr=${error}")
  endif()
  set(last_output "${output}" PARENT_SCOPE)
endfunction()
