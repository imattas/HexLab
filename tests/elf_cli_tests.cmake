execute_process(COMMAND "${GENERATOR}" "${FIXTURES}" RESULT_VARIABLE generated TIMEOUT 15)
if(NOT "${generated}" STREQUAL "0")
  message(FATAL_ERROR "ELF fixture generation failed")
endif()
set(failures 0)
function(check_cli expected pattern)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
  if(NOT "${status}" STREQUAL "${expected}" OR NOT output MATCHES "${pattern}")
    message(STATUS "FAILED '${ARGN}': expected ${expected}/${pattern}; got ${status}\n${output}\n${error}")
    math(EXPR next "${failures}+1")
    set(failures ${next} PARENT_SCOPE)
  endif()
endfunction()
foreach(width 32 64)
  foreach(format auto elf)
    check_cli(0 "ELF: class=${width} endian=little type=REL" inspect "${FIXTURES}/object${width}.o" --format ${format})
    check_cli(0 "ELF: class=${width} endian=little type=DYN" inspect "${FIXTURES}/shared${width}.so" --format ${format})
    check_cli(0 "ELF: class=${width} endian=little type=EXEC" inspect "${FIXTURES}/exec${width}.elf" --format ${format})
    set(project "${FIXTURES}/object${width}-${format}.hxproj")
    file(REMOVE "${project}" "${project}-wal" "${project}-shm")
    check_cli(0 "Saved:" project create "${project}" --input "${FIXTURES}/object${width}.o" --format ${format})
    check_cli(0 "ELF: class=${width}.*type=REL" project inspect "${project}")
    check_cli(0 "Function: va:1:0x0.*caller.*Function: va:2:0x0.*callee" project functions "${project}")
  endforeach()
  check_cli(0 "name=callee.*address=va:2:0x0" inspect "${FIXTURES}/object${width}.o")
  check_cli(0 "NEEDED: libfixture.so" inspect "${FIXTURES}/shared${width}.so")
  check_cli(0 "SONAME: fixture.so.*RUNPATH: [$]ORIGIN" inspect "${FIXTURES}/shared${width}.so")
  check_cli(0 "va:1:0x0.*call.*va:2:0x0.*nop" disassemble "${FIXTURES}/object${width}.o" --format elf)
  check_cli(0 "nop.*ret" disassemble "${FIXTURES}/shared${width}.so" --format elf)
  check_cli(0 "nop.*ret" disassemble "${FIXTURES}/exec${width}.elf")
endforeach()
check_cli(0 "addi.*ebreak" disassemble "${FIXTURES}/rv64c.elf" --format elf)
set(project "${FIXTURES}/object64-elf.hxproj")
check_cli(0 "Edit revision: 1" project rename "${project}" --at va:1:0 --name caller_owned)
check_cli(0 "Edit revision: 2" project rename "${project}" --at va:2:0 --name callee_owned)
check_cli(0 "va:1:0x0.*va:2:0x0.*elf-relocation" project references "${project}" --at va:1:0 --direction outgoing)
check_cli(0 "Edit revision: 3" project patch "${project}" --at file:0x101 --bytes FD)
check_cli(0 "Edit revision: 4" project undo "${project}")
check_cli(0 "Edit revision: 5" project redo "${project}")
file(REMOVE "${FIXTURES}/object-patched.o")
check_cli(0 "Exported:" project export "${project}" --output "${FIXTURES}/object-patched.o")
file(READ "${FIXTURES}/object-patched.o" patched HEX)
file(READ "${FIXTURES}/object64.o" original HEX)
string(SUBSTRING "${original}" 0 514 prefix)
string(SUBSTRING "${original}" 516 -1 suffix)
if(NOT patched STREQUAL "${prefix}fd${suffix}")
  message(FATAL_ERROR "ELF CLI export differs beyond exact patch")
endif()
check_cli(2 "^$" inspect "${FIXTURES}/object64.o" --format elf --base 0)
file(REMOVE "${FIXTURES}/object64.o")
check_cli(0 "caller_owned.*callee_owned" project inspect "${project}" --readonly)
check_cli(0 "endian=big" inspect "${FIXTURES}/big64.elf" --format elf)
check_cli(0 "symbol-table.*count=unavailable" inspect "${FIXTURES}/unbounded64.so" --format elf)
check_cli(1 "^$" disassemble "${FIXTURES}/big64.elf" --format elf)
check_cli(1 "^$" inspect "${FIXTURES}/bad.elf")
check_cli(1 "^$" inspect "${FIXTURES}/bad.elf" --format elf)
check_cli(0 "auto[|]pe[|]elf[|]raw" --help)
check_cli(0 "auto[|]pe[|]elf[|]raw" project --help)
