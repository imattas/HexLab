set(work "${FIXTURES}/project-exchange")
file(MAKE_DIRECTORY "${work}")
file(WRITE "${work}/input.bin" "ABCDEFGH")
file(REMOVE "${work}/source.hxproj" "${work}/source.hxproj-wal" "${work}/source.hxproj-shm"
  "${work}/target.hxproj" "${work}/target.hxproj-wal" "${work}/target.hxproj-shm" "${work}/user.hxex")
set(source "${work}/source.hxproj")
set(target "${work}/target.hxproj")
set(exchange "${work}/user.hxex")
function(run_cli expected out_pattern err_pattern)
  execute_process(COMMAND "${CLI}" project ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
  if(NOT "${status}" STREQUAL "${expected}" OR NOT output MATCHES "${out_pattern}" OR NOT error MATCHES "${err_pattern}")
    message(FATAL_ERROR "Command '${ARGN}' expected ${expected}, got ${status}\nstdout=${output}\nstderr=${error}")
  endif()
endfunction()
run_cli(0 "Saved:" "^$" create "${source}" --input "${work}/input.bin" --format raw --arch x86-64 --base 0x1000)
run_cli(0 "Edit revision:" "^$" comment "${source}" --at file:0 --text "portable note")
run_cli(0 "Edit revision:" "^$" bookmark "${source}" --at file:1 --label "portable mark")
run_cli(0 "Edit revision:" "^$" reference "${source}" --at file:2 --to file:3 --kind read)
run_cli(0 "Exported exchange: 1 annotations, 1 bookmarks, 1 references" "^$" exchange export "${source}" --output "${exchange}")
run_cli(0 "Saved:" "^$" create "${target}" --input "${work}/input.bin" --format raw --arch x86-64 --base 0x1000)
run_cli(0 "Imported exchange: annotations=1 bookmarks=1 references=1 .*types=0 type-assignments=0 .*skipped=0" "^$" exchange import "${target}" --input "${exchange}")
run_cli(0 "Imported exchange: annotations=0 bookmarks=0 references=0 .*types=0 type-assignments=0 .*skipped=3" "^$" exchange import "${target}" --input "${exchange}")
