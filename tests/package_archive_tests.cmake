if(NOT CPACK_COMMAND OR NOT CPACK_CONFIG OR NOT CPACK_GENERATOR OR NOT ARCHIVE)
  message(FATAL_ERROR "Package test requires CPACK_COMMAND, CPACK_CONFIG, CPACK_GENERATOR and ARCHIVE")
endif()
get_filename_component(archive_dir "${ARCHIVE}" DIRECTORY)
file(MAKE_DIRECTORY "${archive_dir}")
set(cpack_command "${CPACK_COMMAND}" --config "${CPACK_CONFIG}" -G "${CPACK_GENERATOR}" -B "${archive_dir}")
if(CPACK_CONFIG_TYPE)
  list(APPEND cpack_command -C "${CPACK_CONFIG_TYPE}")
endif()
execute_process(COMMAND ${cpack_command} RESULT_VARIABLE package_status
  OUTPUT_VARIABLE package_output ERROR_VARIABLE package_error TIMEOUT 180)
if(NOT "${package_status}" STREQUAL "0")
  message(FATAL_ERROR "Could not build package: ${package_status}; ${package_output}; ${package_error}")
endif()
if(NOT EXISTS "${ARCHIVE}")
  message(FATAL_ERROR "CPack did not create expected archive: ${ARCHIVE}")
endif()
file(MAKE_DIRECTORY "${EXTRACT_DIR}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${ARCHIVE}"
  WORKING_DIRECTORY "${EXTRACT_DIR}" RESULT_VARIABLE extract_status
  OUTPUT_VARIABLE extract_output ERROR_VARIABLE extract_error)
if(NOT "${extract_status}" STREQUAL "0")
  message(FATAL_ERROR "Could not extract package: ${extract_status}; ${extract_output}; ${extract_error}")
endif()
file(GLOB roots LIST_DIRECTORIES TRUE "${EXTRACT_DIR}/*")
set(package_root "")
foreach(root IN LISTS roots)
  if(EXISTS "${root}/bin/hexlab_cli.exe" OR EXISTS "${root}/bin/hexlab_cli")
    set(package_root "${root}")
    break()
  endif()
endforeach()
if(NOT package_root)
  message(FATAL_ERROR "Package archive has no HexLab bin/ directory")
endif()
foreach(relative IN ITEMS "share/hexlab/docs/README.md"
    "share/hexlab/docs/capabilities.csv" "share/hexlab/docs/third-party.md"
    "share/hexlab/licenses/sqlite/NOTICE" "share/hexlab/licenses/sqlite/provenance.json"
    "share/hexlab/licenses/zydis/LICENSE" "share/hexlab/licenses/zycore/LICENSE"
    "share/hexlab/licenses/capstone/LICENSE.TXT"
    "share/hexlab/licenses/capstone/LICENSE_LLVM.TXT")
  if(NOT EXISTS "${package_root}/${relative}")
    message(FATAL_ERROR "Package is missing ${relative}")
  endif()
endforeach()
if(WIN32)
  set(cli "${package_root}/bin/hexlab_cli.exe")
  set(runtime_bin "${package_root}/bin")
  set(runtime_directories "${package_root}/bin;$ENV{SystemRoot}/System32;$ENV{SystemRoot}")
else()
  set(cli "${package_root}/bin/hexlab_cli")
  set(runtime_bin "${package_root}/bin")
  set(runtime_directories "${package_root}/bin")
endif()
foreach(component IN ITEMS core image firmware loaders database processors types analysis
    workspace automation debugger plugins decompiler symbols compare)
  if(WIN32)
    set(runtime_file "${package_root}/bin/hexlab_${component}.dll")
  else()
    file(GLOB runtime_files "${package_root}/lib/*hexlab_${component}*")
    if(NOT runtime_files)
      message(FATAL_ERROR "Package is missing the ${component} engine runtime library")
    endif()
  endif()
  if(WIN32 AND NOT EXISTS "${runtime_file}")
    message(FATAL_ERROR "Package is missing the ${component} engine runtime DLL: ${runtime_file}")
  endif()
endforeach()
if(WIN32 AND NOT EXISTS "${package_root}/bin/hexlab_sqlite3.dll")
  message(FATAL_ERROR "Package is missing the SQLite runtime DLL")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "PATH=${runtime_directories}"
    "${cli}" --version WORKING_DIRECTORY "${runtime_bin}" RESULT_VARIABLE cli_status
  OUTPUT_VARIABLE cli_output ERROR_VARIABLE cli_error TIMEOUT 20)
if(NOT "${cli_status}" STREQUAL "0" OR NOT cli_output MATCHES "^HexLab ")
  message(FATAL_ERROR "Packaged CLI failed: ${cli_status}; ${cli_output}; ${cli_error}")
endif()
foreach(smoke_case IN ITEMS "--help|Usage: hexlab_cli" "project --help|project <action>"
    "archive --help|archive list" "firmware inspect --help|firmware inspect")
  string(REPLACE "|" ";" smoke_parts "${smoke_case}")
  list(GET smoke_parts 0 smoke_command)
  list(GET smoke_parts 1 smoke_pattern)
  separate_arguments(smoke_args NATIVE_COMMAND "${smoke_command}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "PATH=${runtime_directories}"
    "${cli}" ${smoke_args} WORKING_DIRECTORY "${runtime_bin}" RESULT_VARIABLE smoke_status
    OUTPUT_VARIABLE smoke_output ERROR_VARIABLE smoke_error TIMEOUT 20)
  if(NOT "${smoke_status}" STREQUAL "0" OR NOT smoke_output MATCHES "${smoke_pattern}")
    message(FATAL_ERROR "Packaged CLI command '${smoke_command}' failed: ${smoke_status}; ${smoke_output}; ${smoke_error}")
  endif()
endforeach()
if(EXPECT_DESKTOP)
  if(WIN32)
    set(gui "${package_root}/bin/hexlab.exe")
    file(GLOB wx_dlls "${package_root}/bin/wx*.dll")
    if(NOT EXISTS "${gui}" OR NOT wx_dlls)
      message(FATAL_ERROR "Desktop archive is missing hexlab.exe or wxWidgets runtime DLLs")
    endif()
    foreach(notice IN ITEMS wxwidgets pcre zlib png jpeg tiff expat nanosvg)
      file(GLOB notice_files "${package_root}/share/hexlab/licenses/${notice}/*")
      if(NOT notice_files)
        message(FATAL_ERROR "Desktop package is missing ${notice} notices")
      endif()
    endforeach()
  else()
    message(FATAL_ERROR "Desktop package archive validation is currently supported only on Windows")
  endif()
endif()
message(STATUS "Verified runnable package: ${ARCHIVE}")
