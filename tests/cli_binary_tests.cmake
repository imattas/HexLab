function(check_binary expected_status expected_out expected_err)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
  if(NOT "${status}" STREQUAL "${expected_status}" OR NOT output MATCHES "${expected_out}" OR NOT error MATCHES "${expected_err}")
    message(FATAL_ERROR "Args '${ARGN}': expected ${expected_status}; got ${status}\nstdout=${output}\nstderr=${error}")
  endif()
endfunction()
