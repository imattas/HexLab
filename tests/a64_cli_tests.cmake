function(check_cli status pattern)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
  if(NOT "${code}" STREQUAL "${status}" OR NOT "${output}${error}" MATCHES "${pattern}")
    message(FATAL_ERROR "A64 CLI '${ARGN}': ${code}; ${output}; ${error}")
  endif()
endfunction()
check_cli(3 "bl 0x1010" disassemble "${raw}" --format raw --arch a64 --base 0x1000)
