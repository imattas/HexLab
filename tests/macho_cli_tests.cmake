if(NOT "${generated}" STREQUAL "0")
  message(FATAL_ERROR "Mach-O fixture generation failed")
endif()
set(failures 0)
set(checks 0)
function(check_cli expected pattern)
  math(EXPR next_check "${checks}+1")
  set(checks ${next_check} PARENT_SCOPE)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
  if(NOT "${status}" STREQUAL "${expected}" OR NOT output MATCHES "${pattern}" OR
     ((expected EQUAL 1 OR expected EQUAL 2) AND error STREQUAL ""))
    message(STATUS "FAILED '${ARGN}': expected ${expected}/${pattern}; got ${status}\n${output}\n${error}")
    math(EXPR next "${failures}+1")
    set(failures ${next} PARENT_SCOPE)
  endif()
endfunction()
