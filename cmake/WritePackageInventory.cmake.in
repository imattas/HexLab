# Write a checksum inventory of the deployed install tree. This install-time
# step runs for both ordinary installs and CPack staging, after all payloads
# have been copied. The inventory is relative to the install prefix so it can
# be checked after the directory or archive has been moved.
set(_hexlab_prefix "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(_hexlab_inventory "${_hexlab_prefix}/@CMAKE_INSTALL_DATADIR@/hexlab/package-files.sha256")
get_filename_component(_hexlab_inventory_dir "${_hexlab_inventory}" DIRECTORY)
if(NOT IS_DIRECTORY "${_hexlab_prefix}")
  message(FATAL_ERROR "HexLab install prefix does not exist: ${_hexlab_prefix}")
endif()
file(MAKE_DIRECTORY "${_hexlab_inventory_dir}")
file(GLOB_RECURSE _hexlab_files LIST_DIRECTORIES FALSE RELATIVE "${_hexlab_prefix}" "${_hexlab_prefix}/*")
list(SORT _hexlab_files)
file(WRITE "${_hexlab_inventory}" "# SHA-256 checksums for files in this HexLab install tree; paths are prefix-relative.\n")
foreach(_hexlab_relative IN LISTS _hexlab_files)
  file(TO_CMAKE_PATH "${_hexlab_relative}" _hexlab_relative)
  if(_hexlab_relative STREQUAL "@CMAKE_INSTALL_DATADIR@/hexlab/package-files.sha256")
    continue()
  endif()
  file(SHA256 "${_hexlab_prefix}/${_hexlab_relative}" _hexlab_sha256)
  file(APPEND "${_hexlab_inventory}" "${_hexlab_sha256}  ${_hexlab_relative}\n")
endforeach()
